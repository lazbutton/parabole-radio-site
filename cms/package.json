{
  "name": "@parabole/cms",
  "version": "0.1.0",
  "private": true,
  "description": "CMS maison de Parabole Radio : modèle de données, base Supabase (Postgres) et fonctions de lecture pour le site.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --experimental-strip-types --no-warnings scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
