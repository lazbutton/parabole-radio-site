# Variables du CMS (cms/README.md, « Variables d'environnement »).
# Copier en cms/.env pour le travail en local : .env n'est jamais versionné. En ligne, les poser dans Vercel.
# Sans DATABASE_URL, tout tourne sur la base locale PGlite (cms/.pglite) : rien à remplir pour développer.

# Base Postgres de Supabase. En ligne (Vercel) : la chaîne « Transaction pooler », port 6543.
# Pour lancer les migrations depuis un ordinateur : la chaîne « Session pooler », port 5432.
DATABASE_URL=

# Supabase Auth (connexion de l'équipe par lien magique, écrans d'admin).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur seulement, pour inviter un membre et envoyer les images. Jamais dans le navigateur.
SUPABASE_SECRET_KEY=

# Supabase Storage : l'adresse publique du seau « media », https://<ref>.supabase.co/storage/v1/object/public/media.
# Les envois (écrans d'admin) passent par SUPABASE_SECRET_KEY.
PUBLIC_MEDIA_URL=

# Import quotidien de la programmation Radio Cult (tâche planifiée de Vercel).
CRON_SECRET=
