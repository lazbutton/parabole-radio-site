---
/**
 * Les shows dans l'admin : tous, brouillons compris, du plus récent au plus ancien (ceux sans date en tête), rangés
 * par mois, avec les filtres de cms/README.md (9.2) : l'état (à traiter, en attente, en ligne), le type, l'étiquette (un
 * groupe vaut pour ses étiquettes), l'artiste, et la recherche. Ce qui manque (`missing`) et le statut (`status`)
 * filtrent encore, sans pastille : l'accueil y mène. Les filtres sont dans l'adresse : une liste filtrée se garde en
 * favori ou se partage avec l'équipe. Servie en HTML ou en JSON, comme chaque écran.
 */
import type { Screen } from "../../../components/admin/types";
import Admin from "../../../layouts/Admin.astro";
import { duration, parisMonth, parisShortDay, parisTime } from "../../../lib/admin/format";
import { json, wantsJson } from "../../../lib/admin/views";

export const prerender = false;

const PER_PAGE = 50;
const admin = Astro.locals.admin!;
const params = Astro.url.searchParams;
const filters = {
  q: params.get("q")?.trim() ?? "",
  step: params.get("step") ?? "",
  status: params.get("status") ?? "",
  type: params.get("type") ?? "",
  tag: params.get("tag") ?? "",
  artist: params.get("artist") ?? "",
  missing: params.get("missing") ?? "",
  order: params.get("order") === "oldest" ? "oldest" : "recent",
};
const page = Math.max(1, Math.trunc(Number(params.get("page"))) || 1);
const now = new Date();
const [result, choices, tags, steps] = await Promise.all([
  admin.listShows({ ...filters, now, limit: PER_PAGE, offset: (page - 1) * PER_PAGE }),
  admin.showChoices(),
  admin.tagFilter("show", { used: true }),
  admin.showSteps(),
]);
const screen: Screen = {
  name: "shows",
  title: "Émissions",
  data: {
    rows: result.items.map((item) => ({
      id: item.id,
      title: item.title,
      artists: item.artists.join(", "),
      type: item.type,
      day: item.broadcastAt ? parisShortDay(item.broadcastAt) : "",
      time: item.broadcastAt ? parisTime(item.broadcastAt) : "",
      month: item.broadcastAt ? parisMonth(item.broadcastAt) : "",
      upcoming: Boolean(item.broadcastAt && item.broadcastAt > now),
      duration: item.durationSeconds ? duration(item.durationSeconds) : "",
      tracks: item.tracks,
      hasSound: item.hasSound,
      hasCover: item.hasCover,
      hasDescription: item.hasDescription,
      tags: item.tags,
      status: item.status,
      fromRadioCult: item.fromRadioCult,
      step: item.step,
      lacking: item.lacking,
    })),
    total: result.total,
    page,
    pages: Math.max(1, Math.ceil(result.total / PER_PAGE)),
    filters,
    steps,
    artists: choices.artists,
    tags,
  },
};
if (wantsJson(Astro.request)) return json(screen);
---

<Admin screen={screen} />
