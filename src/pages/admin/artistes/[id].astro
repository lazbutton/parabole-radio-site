---
/**
 * La fiche d'un artiste : la créer (/admin/artistes/nouveau) ou la modifier (cms/README.md, 9.2). Même contrat que la
 * fiche d'un show : l'écran en GET (HTML ou JSON), la fiche envoyée par l'écran (ArtistEditor) en POST, et une
 * réponse en JSON. La photo se change à part (« photo ») : une image déjà envoyée (/admin/api/media) prend sa place
 * tout de suite, et l'ancienne est retirée du Storage si rien d'autre ne s'en sert.
 */
import { readArtistForm, type AdminArtist } from "@parabole/cms";
import type { PlaceResponse, Screen } from "../../../components/admin/types";
import Admin from "../../../layouts/Admin.astro";
import { parisDateTime } from "../../../lib/admin/format";
import { artistFormFrom, intentOf } from "../../../lib/admin/forms";
import { seeOther } from "../../../lib/admin/paths";
import { removeImages } from "../../../lib/admin/storage";
import { artistSheet, json, mediaView, wantsJson } from "../../../lib/admin/views";

export const prerender = false;

const admin = Astro.locals.admin!;
const isNew = Astro.params.id === "nouveau";
const artist: AdminArtist | null = isNew ? null : await admin.getArtist(Astro.params.id ?? "");
const posted = Astro.request.method === "POST";
if (!isNew && !artist) return posted ? json({ ok: false, errors: { form: "Cet artiste n'existe plus : il a peut-être été supprimé." } }, 404) : seeOther("/admin/artistes");

if (posted) {
  const data = await Astro.request.formData();
  if (data.get("intent") === "photo") {
    if (!artist) return json({ ok: false, errors: { form: "Enregistre d'abord la fiche, puis ajoute sa photo." } }, 400);
    const placed = await admin.placeMedia("photo", { id: artist.id, mediaId: String(data.get("media") ?? "") || null, version: String(data.get("version") ?? "") });
    if (!placed.ok) return json(placed, 422);
    await removeImages(await admin.releaseMedia([placed.previous]));
    const fresh = await admin.getArtist(artist.id);
    return json({ ok: true, image: mediaView(fresh?.photo ?? null), version: placed.version, updated: fresh ? parisDateTime(fresh.updatedAt) : null } satisfies PlaceResponse);
  }
  const intent = intentOf(data);
  if (intent === "delete") {
    if (!artist) return json({ ok: false, errors: { form: "Cet artiste n'est pas encore créé." } }, 400);
    const removed = await admin.deleteArtist(artist.id);
    await removeImages(await admin.releaseMedia([removed?.photoId]));
    return json({ ok: true, redirect: "/admin/artistes", message: `« ${removed?.name ?? artist.name} » supprimé` });
  }
  const read = readArtistForm(artistFormFrom(data));
  if (Object.keys(read.errors).length) return json({ ok: false, errors: read.errors }, 422);
  const status = intent === "publish" ? "published" : intent === "unpublish" ? "draft" : undefined;
  const version = String(data.get("version") ?? "");
  const result = await admin.saveArtist({ id: artist?.id, version: artist ? version : undefined, values: read.values, status });
  if (!result.ok) return json({ ok: false, errors: result.errors, version: result.version }, 422);
  return json({ ok: true, created: isNew, sheet: await artistSheet(admin, await admin.getArtist(result.id)) });
}

const screen: Screen = { name: "artist", title: artist?.name ?? "Nouvel artiste", data: { sheet: await artistSheet(admin, artist) } };
if (wantsJson(Astro.request)) return json(screen);
---

<Admin screen={screen} />
