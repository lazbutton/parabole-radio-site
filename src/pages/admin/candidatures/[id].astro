---
/**
 * Une candidature (cms/README.md, 9.17) : tout ce qu'elle dit, et ce que l'équipe en fait, en POST (réponse en JSON) :
 *   - note : la note de l'équipe ;
 *   - shortlist, reopen : la mettre de côté, la remettre à écouter ;
 *   - accept : la validation, qui crée l'émission en brouillon avec son son, et la fiche d'invité (ou reprend la fiche
 *     du même nom), au nom de la personne connectée ; l'écran prépare ensuite le message à envoyer. La candidature est
 *     effacée six mois après, par la tâche de nuit ;
 *   - decline : « pas cette fois » ; on ne répond qu'aux émissions retenues, elle est donc effacée tout de suite, avec
 *     son son (seau R2) et sa photo (Storage) ;
 *   - delete : l'effacer tout de suite (une candidature validée, avant ses six mois, ou à la demande de la personne).
 */
import type { Accepted, NotSaved } from "@parabole/cms";
import type { ApplicationResponse, Screen } from "../../../components/admin/types";
import Admin from "../../../layouts/Admin.astro";
import { seeOther } from "../../../lib/admin/paths";
import { removeImages } from "../../../lib/admin/storage";
import { applicationSheet, json, wantsJson } from "../../../lib/admin/views";
import { removeFiles } from "../../../lib/r2";

export const prerender = false;

const admin = Astro.locals.admin!;
const id = Astro.params.id ?? "";
const now = new Date();
const application = await admin.getApplication(id);
const posted = Astro.request.method === "POST";
if (!application) return posted ? json({ ok: false, errors: { form: "Cette candidature n'existe plus : elle a peut-être été effacée." } }, 404) : seeOther("/admin/candidatures");

if (posted) {
  const data = await Astro.request.formData();
  const intent = String(data.get("intent") ?? "");
  if (intent === "delete") {
    const deleted = await admin.deleteApplication(id);
    if (deleted) await Promise.all([removeFiles(deleted.keys), removeImages(deleted.images)]);
    return json({ ok: true, redirect: "/admin/candidatures", message: `Candidature de « ${deleted?.name ?? application.name} » effacée` });
  }
  let done: { ok: true } | Accepted | NotSaved;
  let message: string;
  switch (intent) {
    case "note":
      done = await admin.noteApplication(id, String(data.get("note") ?? ""));
      message = "Note enregistrée";
      break;
    case "shortlist":
      done = await admin.moveApplication(id, "shortlisted");
      message = "Mise de côté";
      break;
    case "reopen":
      done = await admin.moveApplication(id, "new");
      message = "Remise à écouter";
      break;
    case "accept": {
      const accepted = await admin.acceptApplication(id);
      done = accepted;
      message = accepted.ok
        ? accepted.reused
          ? `Validée ! « ${accepted.showTitle} » est créée en brouillon, avec la fiche « ${accepted.artistName} », qui existait déjà`
          : `Validée ! « ${accepted.showTitle} » et la fiche « ${accepted.artistName} » sont créées en brouillon`
        : "";
      break;
    }
    case "decline": {
      const declined = await admin.declineApplication(id);
      if (!declined.ok) return json(declined, 422);
      await Promise.all([removeFiles(declined.keys), removeImages(declined.images)]);
      return json({ ok: true, redirect: "/admin/candidatures", message: `Pas cette fois : la candidature de « ${declined.name} » est effacée` });
    }
    default:
      return json({ ok: false, errors: { form: "Action inconnue." } }, 400);
  }
  if (!done.ok) return json(done, 422);
  const fresh = await admin.getApplication(id);
  if (!fresh) return json({ ok: false, errors: { form: "Cette candidature n'existe plus : elle a peut-être été effacée." } }, 404);
  return json({ ok: true, sheet: applicationSheet(fresh, now), message } satisfies ApplicationResponse);
}

const screen: Screen = { name: "application", title: application.title ?? application.name, data: { sheet: applicationSheet(application, now) } };
if (wantsJson(Astro.request)) return json(screen);
---

<Admin screen={screen} />
