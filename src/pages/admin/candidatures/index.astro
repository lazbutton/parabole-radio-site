---
/**
 * Les candidatures dans l'admin (cms/README.md, 9.17) : la liste, les plus récentes d'abord ; par défaut, celles qui
 * attendent une réponse (à écouter, mises de côté). Les filtres : statut, type, émission déjà prête, sans réponse
 * au-delà du délai annoncé, et la recherche (nom, compte Instagram, adresse e-mail, ville). Un admin y règle les
 * candidatures (POST, intent=settings) : les types ouverts sur la page, et le délai de réponse qu'elle annonce. Servie
 * en HTML ou en JSON, comme chaque écran.
 */
import type { ApplicationSettingsResponse, Screen } from "../../../components/admin/types";
import Admin from "../../../layouts/Admin.astro";
import { applicationRow, json, wantsJson } from "../../../lib/admin/views";

export const prerender = false;

const admin = Astro.locals.admin!;
const canSettle = Astro.locals.member?.role === "admin";

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  if (data.get("intent") !== "settings") return json({ ok: false, errors: { form: "Action inconnue." } }, 400);
  if (!canSettle) return json({ ok: false, errors: { form: "Seul un admin règle les candidatures." } }, 403);
  const saved = await admin.saveApplicationSettings({ openTypes: data.getAll("openTypes").map(String), replyDays: Number(data.get("replyDays")) });
  if (!saved.ok) return json(saved, 422);
  const settings = await admin.applicationSettings();
  const ouverts = settings.openTypes.length;
  return json({
    ok: true,
    message: ouverts ? "Réglages enregistrés : la page les montre d'ici une minute" : "Candidatures fermées : la page le dit d'ici une minute",
    settings,
  } satisfies ApplicationSettingsResponse);
}

const params = Astro.url.searchParams;
const filters = {
  q: params.get("q")?.trim() ?? "",
  status: params.get("status") ?? "",
  type: params.get("type") ?? "",
  ready: params.get("ready") ?? "",
  late: params.get("late") ?? "",
};
const now = new Date();
const [list, settings] = await Promise.all([admin.listApplications({ ...filters, status: filters.status || "todo" }, now), admin.applicationSettings()]);
const screen: Screen = {
  name: "applications",
  title: "Candidatures",
  data: { rows: list.rows.map((row) => applicationRow(row, now)), total: list.total, filters, counts: list.counts, settings, canSettle },
};
if (wantsJson(Astro.request)) return json(screen);
---

<Admin screen={screen} />
