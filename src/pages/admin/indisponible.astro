---
/**
 * L'admin ne peut pas répondre : un réglage manque (Vercel, .env), ou Supabase ne répond pas. La garde
 * (src/middleware.ts) affiche cette page à la place de celle demandée, avec la raison.
 */
import Admin from "../../layouts/Admin.astro";
import { seeOther } from "../../lib/admin/paths";

export const prerender = false;

const problem = Astro.locals.problem;
if (!problem) return seeOther("/admin");
Astro.response.status = 503;
Astro.response.headers.set("Retry-After", "60");
---

<Admin title="Admin indisponible">
  <div class="gate">
    <div class="panel">
      <h1 class="panel-head">Admin indisponible</h1>
      <div class="panel-body">
        <p class="flash error" role="alert">{problem}</p>
        <p>Le site public, lui, n'est pas touché. Réessaie dans un moment ; si ça dure, préviens la personne qui s'occupe du site.</p>
        <a class="button secondary" href={Astro.originPathname}>Réessayer</a>
      </div>
    </div>
  </div>
</Admin>
