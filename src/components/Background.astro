---
/**
 * Le fond de toutes les pages : la vidéo d'archives (le clip est tiré par src/scripts/background.ts, dans la liste
 * tenue dans l'admin, Vidéos de fond), la neige du zapping entre deux clips (src/scripts/neige.ts) et l'affichage de la
 * chaîne, un voile bleu, le globe (logo animé, rendu audioréactif par src/scripts/globe.ts) et la surimpression du
 * mode staff. Il ne quitte jamais la page : la vidéo continue d'une rubrique à l'autre. Au chargement, il s'allume comme
 * un téléviseur (src/styles/tele.css). Le filtre cathodique, lui, est posé sur tout le site, au-dessus de tout.
 */
---

<div id="fond" class="fixed inset-0 w-full h-full z-0 overflow-hidden bg-black">
  <!-- Pas de <source> ici : le navigateur commençait à télécharger background.mp4 avant que le script ne change de clip. -->
  <video id="backgroundVideo" class="w-full h-full object-cover" autoplay loop muted playsinline></video>
  <!-- Le mode photo : sur la page d'un artiste, sa photo prend la place de la vidéo (background.ts, data-fond-photo dans
       la page), sur toute la largeur (sur un téléphone, la même photo floutée sous elle) ; sans photo, la mire -->
  <div id="fondPhoto" class="fond-photo" aria-hidden="true">
    <img class="fond-photo-flou" alt="" />
    <img class="fond-photo-nette" alt="" />
  </div>
  <!-- La neige : allumée d'entrée, pour l'allumage ; background.ts l'éteint quand l'image arrive -->
  <canvas id="neige" class="neige visible" aria-hidden="true"></canvas>
  <div class="absolute inset-0 bg-[#000dff]/20 mix-blend-overlay pointer-events-none"></div>
  <!-- Le globe : WebP animé (1,2 Mo) pour les navigateurs récents, APNG (4,4 Mo) en secours -->
  <picture>
    <source srcset="/PARABOLE%20RADIO/OVERLAY/logo.webp" type="image/webp" />
    <img id="logoOverlay" class="logo-overlay" src="/PARABOLE%20RADIO/OVERLAY/logo.apng" alt="Parabole Radio" />
  </picture>
  <!-- La chaîne, comme sur un téléviseur qu'on zappe : son numéro et le nom du clip, quelques secondes -->
  <div id="osd" class="osd" aria-hidden="true">
    <div class="osd-chaine">CH <span id="osdNumero">--</span></div>
    <div id="osdTitre" class="osd-titre"></div>
  </div>
  <div id="overlayCanvasContainer" class="overlay-canvas-container">
    <canvas id="overlayCanvas" class="overlay-canvas"></canvas>
  </div>
</div>
<!-- L'allumage : un point, puis une ligne blanche qui s'ouvre sur l'image (src/styles/tele.css) -->
<div class="allumage-ligne" aria-hidden="true"></div>
<!-- Le filtre cathodique, posé sur tout le site, en-tête et panneaux compris (src/styles/socle.css).
     CRT filter: adapted from "CRT scanline filter" by Tellers - https://tellers.ai/free-svg-vfx/crt-scanline-filter
     - License: CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/). Changes: rebuilt in CSS; the noise
     (under 1/255, invisible), the glow blur, the rolling band, the flashing line, the top band (under the top
     bar) and the screen frame are left out. -->
<div class="crt-filter" aria-hidden="true"></div>
