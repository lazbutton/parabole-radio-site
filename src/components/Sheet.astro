---
/**
 * La « feuille » d'une rubrique : un panneau au design du site (bord jaune, lignes de balayage), posé sur la vidéo entre
 * la barre du haut et le bandeau. Son titre est le <h1> de la page ; `meta` s'affiche à sa droite.
 */
interface Props {
  title: string;
  meta?: string;
}
const { title, meta } = Astro.props;
---

<article class="feuille">
  <header class="feuille-tete">
    <h1>{title}</h1>
    {meta && <span class="feuille-meta">{meta}</span>}
    <slot name="tete" />
  </header>
  <slot />
</article>
