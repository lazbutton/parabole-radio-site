---
/**
 * L'emplacement d'une image (pochette d'un show, photo d'un artiste). L'envoi vers Cloudflare R2 (cms/README.md, 9.3)
 * viendra quand le seau existera : pour l'instant, l'emplacement montre l'image enregistrée, s'il y en a une.
 */
interface Props {
  label: string;
  media: { key: string; alt: string } | null;
}
const { label, media } = Astro.props;
---

<div class="field">
  <span class="field-label">{label} <span class="optional">— image carrée</span></span>
  <div class="media-slot">
    <div class="frame" aria-hidden="true">{media ? "Image enregistrée" : "Pas d'image"}</div>
    <div class="field">
      {
        media && (
          <p class="hint">
            {media.key}
            {media.alt ? ` — « ${media.alt} »` : " — sans texte alternatif"}
          </p>
        )
      }
      <div>
        <button type="button" class="button quiet small" disabled>Choisir une image</button>
      </div>
      <p class="hint">L'envoi des images arrive avec la prochaine étape de l'admin, quand le stockage Cloudflare R2 sera prêt.</p>
    </div>
  </div>
</div>
