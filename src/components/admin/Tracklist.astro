---
/**
 * La tracklist d'un show, dans sa fiche : un morceau par ligne (minutage, artiste, titre, lien Hopper), dans l'ordre.
 * Les champs se répètent ligne après ligne et le formulaire les envoie dans cet ordre : c'est l'ordre enregistré.
 * Réordonner, ajouter une ligne et coller une tracklist en texte : src/scripts/admin/tracklist.ts.
 */
import type { FieldErrors, TrackLine } from "@parabole/cms";

interface Props {
  tracks: TrackLine[];
  errors: FieldErrors;
}
const { tracks, errors } = Astro.props;
const FIELDS = ["start", "artist", "title", "hopperUrl"] as const;
const problems = (index: number) => FIELDS.map((field) => errors[`tracks.${index}.${field}`]).filter(Boolean);
const invalid = (index: number, field: (typeof FIELDS)[number]) => (errors[`tracks.${index}.${field}`] ? "true" : undefined);
const count = tracks.length;
---

<section class="panel" data-tracklist aria-labelledby="tracklist-title">
  <h2 class="panel-head" id="tracklist-title">
    Tracklist <span class="count">{count ? `${count} ${count > 1 ? "morceaux" : "morceau"}` : ""}</span>
  </h2>
  <div class="panel-body">
    {errors.tracks && <p class="error-text">{errors.tracks}</p>}
    <div>
      <div class="tracklist-head" aria-hidden="true">
        <span>Minutage</span><span>Artiste</span><span>Titre</span><span>Lien Hopper</span>
      </div>
      <ol class="tracks">
        {
          tracks.map((line, index) => (
            <li class="track">
              <span class="drag-handle" data-js aria-hidden="true" title="Glisser pour déplacer">
                ⋮⋮
              </span>
              <span class="track-number">{index + 1}</span>
              <label class="start">
                <span class="sr-only">Minutage</span>
                <input type="text" name="trackStart" value={line.start} placeholder="0:00" autocomplete="off" aria-invalid={invalid(index, "start")} />
              </label>
              <label class="artist">
                <span class="sr-only">Artiste</span>
                <input type="text" name="trackArtist" value={line.artist} placeholder="Artiste" autocomplete="off" aria-invalid={invalid(index, "artist")} />
              </label>
              <label class="title">
                <span class="sr-only">Titre</span>
                <input type="text" name="trackTitle" value={line.title} placeholder="Titre" autocomplete="off" aria-invalid={invalid(index, "title")} />
              </label>
              <label class="hopper">
                <span class="sr-only">Lien Hopper</span>
                <input type="text" inputmode="url" name="trackHopper" value={line.hopperUrl} placeholder="https://hppr.fr/…" autocomplete="off" aria-invalid={invalid(index, "hopperUrl")} />
              </label>
              <span class="row-actions" data-js>
                <button type="button" class="icon-button" data-move="up" aria-label="Monter ce morceau">
                  ↑
                </button>
                <button type="button" class="icon-button" data-move="down" aria-label="Descendre ce morceau">
                  ↓
                </button>
                <button type="button" class="icon-button remove" data-remove aria-label="Retirer ce morceau">
                  ✕
                </button>
              </span>
              {problems(index).map((message) => (
                <p class="error-text">{message}</p>
              ))}
            </li>
          ))
        }
      </ol>
      <p class="tracks-empty">Pas encore de morceau. Ajoute-les un par un, ou colle toute la tracklist d'un coup.</p>
      <template>
        <li class="track">
          <span class="drag-handle" aria-hidden="true" title="Glisser pour déplacer">⋮⋮</span>
          <span class="track-number"></span>
          <label class="start"><span class="sr-only">Minutage</span><input type="text" name="trackStart" placeholder="0:00" autocomplete="off" /></label>
          <label class="artist"><span class="sr-only">Artiste</span><input type="text" name="trackArtist" placeholder="Artiste" autocomplete="off" /></label>
          <label class="title"><span class="sr-only">Titre</span><input type="text" name="trackTitle" placeholder="Titre" autocomplete="off" /></label>
          <label class="hopper"><span class="sr-only">Lien Hopper</span><input type="text" inputmode="url" name="trackHopper" placeholder="https://hppr.fr/…" autocomplete="off" /></label>
          <span class="row-actions">
            <button type="button" class="icon-button" data-move="up" aria-label="Monter ce morceau">↑</button>
            <button type="button" class="icon-button" data-move="down" aria-label="Descendre ce morceau">↓</button>
            <button type="button" class="icon-button remove" data-remove aria-label="Retirer ce morceau">✕</button>
          </span>
        </li>
      </template>
    </div>
    <div>
      <button type="button" class="button secondary small" data-js data-add-track>Ajouter un morceau</button>
    </div>
    <details class="paste" open={count === 0 ? true : undefined}>
      <summary>Coller une tracklist</summary>
      <div class="body">
        <label class="sr-only" for="pasted">Tracklist en texte</label>
        <textarea id="pasted" name="pasted" rows="8" placeholder={"0:00 Artiste – Titre\n12:30 Artiste – Titre\n1:02:15 Artiste – Titre"}></textarea>
        <p class="hint">
          Une ligne par morceau : le minutage (m:ss ou h:mm:ss, facultatif), l'artiste, un tiret, le titre. Les numéros, les
          crochets et les liens Hopper sont reconnus, comme les colonnes copiées d'un tableur. Les lignes s'ajoutent à la fin.
        </p>
        <button type="button" class="button secondary small" data-js data-paste>Ajouter ces lignes</button>
      </div>
    </details>
    <p class="hint" aria-live="polite" data-tracks-status></p>
  </div>
</section>
