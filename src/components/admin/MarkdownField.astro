---
/**
 * Un texte long en Markdown (description, bio), avec son aperçu : rendu par le serveur comme sur le site, sans HTML
 * brut (/admin/apercu, src/lib/markdown.ts). Les onglets n'apparaissent qu'avec JavaScript.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  value: string;
  rows?: number;
  hint?: string;
  error?: string;
}
const { id, name, label, value, rows = 8, hint, error } = Astro.props;
---

<div class="field" data-markdown>
  <label class="field-label" for={id}>{label} <span class="optional">— facultatif</span></label>
  <div class="md-tabs" role="group" aria-label={`Affichage de « ${label} »`} data-js>
    <button type="button" aria-pressed="true">Écrire</button>
    <button type="button" aria-pressed="false">Aperçu</button>
  </div>
  <textarea id={id} name={name} rows={rows} aria-invalid={error ? "true" : undefined} aria-describedby={`${id}-hint`}>{value}</textarea>
  <div class="md-preview" hidden></div>
  <p class="hint" id={`${id}-hint`}>{hint ?? "Markdown : **gras**, *italique*, [lien](https://…), une ligne vide entre deux paragraphes."}</p>
  {error && <p class="error-text">{error}</p>}
</div>
