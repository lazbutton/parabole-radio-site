---
/**
 * Le gabarit de toutes les pages. Il pose la « coque » qui ne quitte jamais l'écran : le fond (vidéo, neige du zapping,
 * globe), l'en-tête (le logo, la loupe et le menu, puis la ligne ON AIR et le son), la ligne du bas, les panneaux et
 * le mode staff. Seul <main id="page"> change d'une rubrique à l'autre : le ClientRouter d'Astro charge la
 * page sans rechargement, et une fonction de remplacement maison (src/scripts/router.ts) ne remplace que ce <main>. Le
 * son, la vidéo et le cadre du chat ne sont donc jamais déplacés ni recréés.
 *
 * <html data-page> dit quelle rubrique est ouverte : les styles s'en servent (PROGRAMMATION toujours ouvert sur
 * l'accueil), et la fonction de remplacement le recopie à chaque navigation.
 */
import { ClientRouter } from "astro:transitions";
import Background from "../components/Background.astro";
import BottomBar from "../components/BottomBar.astro";
import Icons from "../components/Icons.astro";
import Panels from "../components/Panels.astro";
import Staff from "../components/Staff.astro";
import TopBar from "../components/TopBar.astro";
import type { Page } from "../lib/menu";
import "../styles/socle.css";
import "../styles/tete.css";
import "../styles/tele.css";
import "../styles/ligne-du-bas.css";
import "../styles/panneaux.css";
import "../styles/antenne.css";
import "../styles/staff.css";
import "../styles/pages.css";
import "../styles/residents.css";
import "../styles/a-propos.css";

interface Props {
  page: Page;
  /** Le nom de la rubrique, pour l'onglet : « À propos — Parabole Radio ». Sans lui, le titre de l'accueil. */
  title?: string;
  description?: string;
  /** L'image de partage d'une page (la photo d'un artiste) : adresse complète. Avec elle, l'aperçu prend sa description. */
  image?: string;
}
const {
  page,
  title,
  description = "Parabole Radio — Union de la Jeunesse Internationale community radio. Live stream from Paris.",
  image,
} = Astro.props;
const documentTitle = title ? `${title} — Parabole Radio` : "Parabole Radio — Live Community Radio • Paris";
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr" data-page={page} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- L'allumage du téléviseur (src/styles/tele.css), posé avant le premier affichage. Seulement au chargement de
         l'onglet : la navigation remplace les attributs de <html> sans relancer ce script, et background.ts l'enlève
         une fois l'image arrivée. Sans script, ou avec « réduire les animations », la page s'affiche telle quelle. -->
    <script is:inline>
      if (!(window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches)) document.documentElement.classList.add("allumage");
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />

    <!-- Favicon : l'émoji antenne parabolique, sans fichier -->
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📡</text></svg>"
    />

    <!-- Aperçu de partage. L'image du site (1200 × 630) reste à faire ; une page peut donner la sienne (image). -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta
      property="og:description"
      content={image ? description : "Union de la Jeunesse Internationale community radio. Live stream from Paris. Ça va péter !!!"}
    />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />

    <!-- Monument Grotesk sert à tout le texte : les deux graisses tout de suite -->
    <link rel="preload" href="/PARABOLE%20RADIO/FONTS/MonumentGrotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/PARABOLE%20RADIO/FONTS/MonumentGrotesk-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Les classes utilitaires, générées une fois avec Tailwind CSS v3.4.17 (feuille figée, à ne pas modifier) -->
    <link rel="stylesheet" href="/PARABOLE%20RADIO/CSS/tailwind.css" />
    <ClientRouter fallback="swap" />
  </head>
  <body class="antialiased">
    <Icons />
    <Background />
    <TopBar page={page} />
    <main id="page">
      <slot />
    </main>
    <BottomBar />
    <Panels />
    <Staff />
    <script>
      import "../scripts/shell";
    </script>
  </body>
</html>
