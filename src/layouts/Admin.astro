---
/**
 * Le document de l'application d'admin (/admin) : une page sans la coque du site, qui rend l'écran demandé dans
 * l'application React (src/components/admin/AdminApp.tsx, Radix Themes). Rendu par le serveur à chaque requête après
 * la garde (src/middleware.ts), puis l'application prend la main : les écrans suivants arrivent en JSON, sans
 * recharger la page. L'entrée (connexion, refus, panne) a son propre gabarit : AdminGate.
 */
import "@radix-ui/themes/styles.css";
import AdminApp from "../components/admin/AdminApp";
import type { Screen } from "../components/admin/types";
import { viewerOf } from "../lib/admin/views";
import "../styles/admin.css";

interface Props {
  /** L'écran à afficher, préparé par la page. */
  screen: Screen;
}
const { screen } = Astro.props;
const viewer = viewerOf(Astro.locals.member!);
const href = Astro.url.pathname + Astro.url.search;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{screen.title} — Admin Parabole</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📡</text></svg>"
    />
  </head>
  <body>
    <AdminApp client:load viewer={viewer} href={href} screen={screen} />
  </body>
</html>
